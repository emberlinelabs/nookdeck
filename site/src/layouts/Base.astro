---
import '@fontsource-variable/geist';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tw.css';
import '../styles/global.css';
import { dicts, paths, SITE, type Lang } from '../i18n';
interface Props { lang: Lang; noindex?: boolean }
const { lang, noindex = false } = Astro.props;
const t = dicts[lang];
const url = SITE + paths[lang];
const og = SITE + '/og.png';
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{noindex ? 'Page not found · Nookdeck' : t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    {(Object.keys(paths) as Lang[]).map((l) => <link rel="alternate" hreflang={dicts[l].htmlLang} href={SITE + paths[l]} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nookdeck" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nookdeck: your old phone, a control panel for your computer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      var t = 'dark'; try { var s = localStorage.getItem('nd-theme'); if (s === 'light' || s === 'dark') t = s; else if (matchMedia('(prefers-color-scheme: light)').matches) t = 'light'; } catch (e) {} document.documentElement.dataset.theme = t;
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Nookdeck',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'macOS, Windows',
      description: t.meta.description,
      license: 'https://opensource.org/licenses/MIT',
      url: SITE,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
