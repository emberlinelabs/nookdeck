---
import Base from '../layouts/Base.astro';
---
<Base lang="en" noindex>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="/" aria-label="Nookdeck"><img src="/img/nookdeck-mark.svg" width="28" height="28" alt="" /><span>Nookdeck</span></a>
    </div>
  </header>
  <main id="main" class="nf">
    <div class="wrap">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="h2">Nothing on this desk.</h1>
      <p class="lead">That page isn’t here. It may have moved, or the link has a typo.</p>
      <p class="nf-links">
        <a class="nd-link" href="/">Back to the desk <span aria-hidden="true">→</span></a>
        <a class="nd-link" href="https://github.com/howznguyen/nookdeck">Nookdeck on GitHub <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </main>
</Base>
<style is:global>
  .nf { padding: clamp(4rem, 12vw, 9rem) 0 clamp(5rem, 14vw, 10rem); }
  .nf-code { font: 600 clamp(6rem, 22vw, 14rem)/.85 var(--font-mono); letter-spacing: -.06em; margin: 0 0 1.5rem; color: var(--muted-foreground); opacity: .5; }
  .nf-links { display: flex; flex-wrap: wrap; gap: .6rem 1.8rem; margin: 2rem 0 0; }
</style>
