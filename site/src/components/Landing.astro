---
import { dicts, paths, GITHUB, type Lang } from '../i18n';
import Hero from './Hero';
import Stage from './Stage';
import AiMoment from './AiMoment';
import Trio from './Trio';
import Faq from './Faq';
import FooterW from './FooterW';
import Install from './Install';
import EndDeck from './EndDeck';
import { getStars, compact } from '../lib/stars';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dicts[lang];
const MAC = 'curl -fsSL https://nookdeck.app/scripts/install | bash';
const WIN = 'irm https://nookdeck.app/scripts/install.ps1 | iex';
const commands = { mac: MAC, win: WIN };
const gh = (p = '') => GITHUB + p;
const stars = await getStars();
const starText = stars === null ? '' : compact(stars);
const starLabel = stars === null ? '' : `${stars} ${t.nav.stars}`;
const { note, ...inst } = t.install;
const ghIcon = 'M12 .5A11.5 11.5 0 0 0 .5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z';
---
<a class="skip" href="#main">{t.skip}</a>

<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={paths[lang]} aria-label="Nookdeck">
      <img src="/img/nookdeck-mark.svg" width="28" height="28" alt="" />
      <span>Nookdeck</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="#demo">{t.nav.demo}</a>
      <a href="#ai">{t.nav.ai}</a>
      <a href="#plugins">{t.nav.plugins}</a>
      <a href="#faq">{t.nav.faq}</a>
    </nav>
    <div class="tools">
      <div class="langs" role="group" aria-label={t.nav.language}>
        {(Object.keys(paths) as Lang[]).map((l) => (
          <a href={paths[l]} hreflang={dicts[l].htmlLang} lang={dicts[l].htmlLang} aria-current={l === lang ? 'true' : undefined} title={dicts[l].label}>{l.toUpperCase()}</a>
        ))}
      </div>
      <button class="icon-btn" type="button" id="theme" aria-label={t.nav.theme}>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class={starText ? 'gh-btn' : 'icon-btn'} href={gh()} aria-label={starText ? `${t.nav.github}, ${starLabel}` : t.nav.github}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={ghIcon}/></svg>
        {starText && <span class="gh-stars" aria-hidden="true">★ {starText}</span>}
      </a>
    </div>
  </div>
</header>

<main id="main">
  <Hero client:load title={t.hero.title} sub={t.hero.sub} window={t.hero.window}
    github={{ label: t.hero.github, href: gh() }} install={{ ...inst, note, commands }}
    soon={{ ...t.soon, href: gh('/releases') }} />

  <section id="demo" class="sec">
    <div class="wrap">
      <h2 class="h2">{t.stage.title}</h2>
      <Stage client:visible label={t.stage.label} tabs={t.stage.tabs} lines={t.stage.lines} comments={t.stage.comments} />
    </div>
  </section>

  <section id="ai" class="sec sec-ai">
    <div class="wrap">
      <div class="ai-head">
        <h2 class="h2">{t.ai.title}</h2>
        <p class="lead">{t.ai.body}</p>
        <p class="small">{t.ai.note}</p>
      </div>
      <AiMoment client:visible prompts={t.ai.prompts} />
    </div>
  </section>

  <section id="how" class="sec">
    <div class="wrap">
      <h2 class="h2">{t.how.title}</h2>
      <ol class="steps">
        {t.how.steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span><h3>{s.title}</h3><p>{s.body}</p>
            <div class="mom" aria-hidden="true">
              {i === 0 && <div class="mom-cmd"><i>$ </i>curl -fsSL https://nookdeck.app/scripts/install | bash<span class="caret"></span></div>}
              {i === 1 && <span class="nd-pins">{['4','0','7','1','9','2'].map((d, k) => <i style={`--i:${k}`}>{d}</i>)}</span>}
              {i === 2 && <div class="mom-grid"><b class="c"></b><b></b><b class="a"></b><b></b><b></b><b class="drag"></b><b></b><b class="c"></b></div>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="plugins" class="wrap">
    <Trio client:visible fileLabel="nookdeck.json"
      plugins={{ ...t.trio.plugins, href: gh('/blob/main/docs/plugins.md') }}
      privacy={{ ...t.trio.privacy, href: gh('/blob/main/PRIVACY.md') }}
      old={t.trio.old} />
  </section>

  <section id="faq" class="wrap">
    <Faq client:visible title={t.faq.title} items={t.faq.items} />
  </section>

  <section id="start" class="sec sec-end">
    <div class="wrap end-grid">
      <div>
        <h2 class="h2 end-title">{t.end.title}</h2>
        <p class="lead">{t.end.lead}</p>
        <div class="end-install"><Install client:visible {...inst} commands={commands} idPrefix="end" big /></div>
        <p class="small">{note}</p>
        <p class="oss-links">
          <span>{t.end.oss}</span>
          {starText && <a class="nd-link" href={gh()}>★ {starText} {t.nav.stars}</a>}
          <a class="nd-link" href={gh('/issues')}>{t.end.issues} <span aria-hidden="true">→</span></a>
          <a class="nd-link" href={gh('#contributing')}>{t.end.contribute} <span aria-hidden="true">→</span></a>
        </p>
        <p class="small">{t.end.thanks}</p>
      </div>
      <div class="end-deck"><EndDeck client:visible /></div>
    </div>
  </section>
</main>

<FooterW client:visible made={t.footer.made} formerly={t.footer.formerly} credits={t.footer.credits} license={t.footer.license}
  links={[
    { label: t.footer.links.github, href: gh() },
    { label: t.footer.links.releases, href: gh('/releases') },
    { label: t.footer.links.privacy, href: gh('/blob/main/PRIVACY.md') },
    { label: t.footer.links.plugins, href: gh('/blob/main/docs/plugins.md') },
    { label: t.footer.links.issues, href: gh('/issues') },
  ]} />

<script is:inline>
  document.getElementById('theme').addEventListener('click', function () {
    var root = document.documentElement;
    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('nd-theme', next); } catch (e) {}
  });
</script>
