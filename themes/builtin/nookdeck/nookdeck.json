{
  "$schema": "https://nookdeck.app/schema/plugin.json",
  "type": "theme",
  "id": "dev.nookdeck.nookdeck",
  "name": "Nookdeck",
  "version": "1.0.0",
  "nookdeck": ">=0.4.0",
  "author": "Nookdeck",
  "description": "The looks that come with Nookdeck: Midnight, Paper, Neon, Forest, Mono and Glass. Auto uses Paper by day and Midnight at night.",
  "auto": { "light": "paper", "dark": "midnight" },
  "css": "theme.css",
  "theme": { "tileStyle": "solid", "radius": 14, "gap": 10 },
  "variants": [
    {
      "id": "midnight", "name": "Midnight", "mode": "dark",
      "theme": {
        "accent": "#22d3ee", "background": "#0b0d12", "gradient": { "from": "#07080c", "to": "#101521", "angle": 180 },
        "tile": "#151923", "text": "#e8ecf4", "muted": "#8a93a6",
        "palette": { "ok": "#34d399", "warn": "#fbbf24", "error": "#f87171", "info": "#38bdf8" },
        "chartColors": ["#22d3ee", "#a78bfa", "#34d399", "#fbbf24", "#f472b6", "#fb923c"]
      }
    },
    {
      "id": "paper", "name": "Paper", "mode": "light",
      "theme": {
        "accent": "#b4532a", "background": "#f6f3ec", "tile": "#ffffff", "text": "#23211c", "muted": "#7a7466",
        "font": "serif", "tileStyle": "outline", "radius": 6, "shadow": "soft",
        "border": { "width": 1.5, "color": "#23211c" },
        "palette": { "ok": "#3f7d4e", "warn": "#b8860b", "error": "#b03a2e", "info": "#2f6690" },
        "chartColors": ["#b4532a", "#2f6690", "#3f7d4e", "#b8860b", "#7b4b94", "#23211c"],
        "kinds": { "clock": { "numberFont": "serif" } }
      }
    },
    {
      "id": "neon", "name": "Neon", "mode": "dark",
      "theme": {
        "accent": "#ff2bd6", "background": "#05050f", "gradient": { "from": "#05050f", "to": "#16003a", "angle": 160 },
        "tile": "#0d0d24", "text": "#f2f0ff", "muted": "#8a86b8", "shadow": "strong", "tileOpacity": 0.92,
        "border": { "width": 1, "color": "#3b1d6e" },
        "palette": { "ok": "#00ffa3", "warn": "#ffe14d", "error": "#ff3b6b", "info": "#29d8ff" },
        "chartColors": ["#ff2bd6", "#29d8ff", "#ffe14d", "#a259ff", "#ff8a3d", "#00ffa3"]
      }
    },
    {
      "id": "forest", "name": "Forest", "mode": "dark",
      "theme": {
        "accent": "#5fd38d", "background": "#0d1a14", "gradient": { "from": "#0a1410", "to": "#122a1f", "angle": 180 },
        "tile": "#16291f", "text": "#e6f2ea", "muted": "#86a392",
        "palette": { "ok": "#5fd38d", "warn": "#e8c66a", "error": "#e87a6a", "info": "#6ac4d8" },
        "chartColors": ["#5fd38d", "#6ac4d8", "#e8c66a", "#e89a6a", "#b48ead", "#a3be8c"]
      }
    },
    {
      "id": "mono", "name": "Mono", "mode": "dark",
      "theme": {
        "accent": "#ffffff", "background": "#0a0a0a", "tile": "#161616", "text": "#f2f2f2", "muted": "#8c8c8c",
        "font": "mono", "tileStyle": "outline", "radius": 4,
        "border": { "width": 1, "color": "#3a3a3a" },
        "palette": { "ok": "#e5e5e5", "warn": "#bdbdbd", "error": "#ffffff", "info": "#9e9e9e" },
        "chartColors": ["#ffffff", "#bdbdbd", "#8c8c8c", "#e5e5e5", "#6e6e6e", "#d4d4d4"]
      }
    },
    {
      "id": "glass", "name": "Glass", "mode": "dark",
      "theme": {
        "accent": "#8be9fd", "background": "#1d2b64", "gradient": { "from": "#1d2b64", "to": "#6a3093", "angle": 150 },
        "tile": "#ffffff", "tileOpacity": 0.14, "tileBlur": 18, "text": "#ffffff", "muted": "#c9d3f5", "shadow": "soft", "radius": 20,
        "border": { "width": 1, "color": "#c9d3f5" },
        "palette": { "ok": "#69f0ae", "warn": "#ffd54f", "error": "#ff8a80", "info": "#8be9fd" },
        "chartColors": ["#8be9fd", "#ffd54f", "#69f0ae", "#ff8a80", "#d1a8ff", "#ffab70"]
      }
    }
  ]
}
